{
  "name": "furniture-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-stack.ps1",
    "start:web": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:phase0": "node --test --experimental-strip-types tests/phase0-security.test.ts",
    "test:release": "node scripts/verify-local-release.mjs",
    "test:runtime": "node scripts/check-local-runtime.mjs",
    "test:crm": "node --test --experimental-strip-types tests/client-crm.test.ts tests/client-crm-migration.test.mjs tests/client-crm-integration.test.mjs",
    "test:accounting": "node --test --experimental-strip-types tests/accounting.test.ts tests/accounting-integration.test.mjs tests/project-summary.test.ts",
    "crm:migrate": "node scripts/migrate-client-crm.mjs",
    "accounting:migrate": "node scripts/migrate-accounting.mjs",
    "local:prepare": "npm run crm:migrate && npm run accounting:migrate && prisma generate && npm run build",
    "test:admin-reset": "node --test tests/admin-reset.test.mjs",
    "test:data-migration": "node --test tests/data-management-migration.test.mjs",
    "test:data-management-core": "node --test --experimental-strip-types tests/data-management-core.test.ts",
    "test:data-management-integration": "node --test tests/data-management-integration.test.mjs",
    "test:data-management": "npm run test:data-management-core && npm run test:data-migration && npm run test:data-management-integration",
    "test:phase1": "node --test tests/phase1-catalog.test.mjs",
    "test:collections": "node --test --experimental-strip-types tests/collection-publication.test.ts",
    "test:catalog-quality": "node --test --experimental-strip-types tests/catalog-quality.test.ts",
    "test:product-media": "node --test --experimental-strip-types tests/product-media.test.ts tests/catalog-publication.test.ts",
    "test:seo": "node --test --experimental-strip-types tests/seo-locales.test.ts tests/storefront-proxy.test.ts",
    "test:analytics": "node --test --experimental-strip-types tests/analytics-contract.test.ts",
    "test:admin-assistant": "node --test --experimental-strip-types tests/admin-assistant.test.ts tests/local-ai-status-contract.test.mjs",
    "test:task-commands": "node --test --experimental-strip-types tests/task-command-bus.test.ts",
    "test:ai-storage": "node --test tests/ai-operations-migration.test.mjs",
    "test:ai-run-ledger": "node --test tests/admin-assistant-run-ledger.test.mjs",
    "test:ai-promotion": "node --test tests/local-ai-model-promotion.test.mjs",
    "test:ai-active-model": "node --test tests/local-ai-active-model.test.mjs",
    "ai:dataset": "python local-ai/generate_dataset.py",
    "ai:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./local-ai/setup.ps1",
    "ai:train": "powershell -NoProfile -ExecutionPolicy Bypass -File ./local-ai/train.ps1",
    "ai:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./local-ai/start.ps1 -Background",
    "ai:evaluate": "D:/hatab-local-ai/.venv/Scripts/python.exe local-ai/evaluate_adapter.py",
    "ai:promote": "node scripts/promote-local-ai-model.mjs",
    "ai:active-model": "node scripts/resolve-active-local-ai-model.mjs",
    "security:migrate": "node scripts/migrate-phase0-security.mjs",
    "data:migrate": "node scripts/migrate-data-management.mjs",
    "admin:reset": "node reset-admin.js",
    "catalog:migrate": "node scripts/migrate-phase1-catalog.mjs",
    "catalog:order-migrate": "node scripts/migrate-catalog-display-order.mjs",
    "catalog:merge": "node scripts/merge-catalog-items.mjs",
    "analytics:migrate": "node scripts/migrate-analytics.mjs",
    "ai:storage-migrate": "node scripts/migrate-ai-operations.mjs",
    "media:backfill": "node scripts/backfill-editorial-media.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "@next/font": "^14.2.15",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.5",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@7.9.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  }
}
