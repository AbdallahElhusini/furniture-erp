DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DATA_BACKUP_DIR="./.data-backups"
ADMIN_NAME="HATAB Administrator"
ADMIN_EMAIL="admin@hatab.local"
ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
HATAB_LOCAL_AI_URL="http://127.0.0.1:11437"
# Optional defense in depth. Set the same value in the Python service environment.
HATAB_LOCAL_AI_SECRET=""
# When the explicit secret is empty, the stack creates and shares a local key here.
HATAB_LOCAL_AI_SECRET_FILE="D:\\hatab-local-ai\\service.key"
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_ADDRESS=""

# Optional Meta ads connection. It remains inactive until explicitly enabled
# and a separate marketing-consent experience has been approved and deployed.
META_ADS_ENABLED="false"
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_TEST_EVENT_CODE=""
META_MARKETING_CONSENT_REQUIRED="true"
